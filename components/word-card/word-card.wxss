.word-card {
  background: linear-gradient(135deg, #e8f8f0 0%, #d0f0e0 100%);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin: 32rpx 0;
}

.word-card-label {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 16rpx;
}

.word-card-word {
  font-size: 72rpx;
  font-weight: 700;
  color: #009c6a;
  margin-bottom: 24rpx;
  letter-spacing: 8rpx;
}

.word-card-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  margin-bottom: 24rpx;
}

.word-card-action:active {
  background: rgba(255, 255, 255, 0.6);
}

.word-card-refresh-icon {
  font-size: 28rpx;
  color: #00b578;
}

.word-card-refresh-text {
  font-size: 26rpx;
  color: #00b578;
}

.word-card-hint {
  font-size: 24rpx;
  color: #888888;
}
