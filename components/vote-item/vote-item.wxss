.vote-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #ffffff;
  border: 2rpx solid #eeeeee;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.vote-item:active {
  transform: scale(0.98);
}

.vote-item-selected {
  border-color: #00b578;
  background: #e8f8f0;
}

.vote-item-info {
  flex: 1;
}

.vote-item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.vote-item-seat {
  font-size: 24rpx;
  color: #888888;
}

.vote-item-action {
  display: flex;
  align-items: center;
}

.vote-item-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #00b578;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.vote-item-btn {
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

.vote-item-btn:active {
  background: #e0e0e0;
}
