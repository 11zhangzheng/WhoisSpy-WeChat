.player-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: flex-start;
}

.player-item {
  width: 140rpx;
}

.player-item:active {
  transform: scale(0.95);
}

.player-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.player-avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #cccccc;
  transition: all 0.2s ease;
}

.player-item-speaking .player-avatar-img {
  background: #e8f8f0;
  border: 4rpx solid #00b578;
  color: #00b578;
}

.player-item-selected .player-avatar-img {
  background: #e8f8f0;
  border: 4rpx solid #00b578;
}

.player-item-dead .player-avatar-img {
  background: #f5f5f5;
  color: #cccccc;
  opacity: 0.6;
}

.player-avatar-spy {
  background: #fde8e8 !important;
  color: #fa5151 !important;
}

.player-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-item-dead .player-name {
  color: #cccccc;
  text-decoration: line-through;
}

.player-seat {
  font-size: 20rpx;
  color: #bbbbbb;
}

.player-badge {
  font-size: 20rpx;
  color: #fa5151;
  background: #fde8e8;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  margin-top: 4rpx;
}

.player-badge-civilian {
  color: #00b578;
  background: #e8f8f0;
}

.player-speaker {
  font-size: 20rpx;
  color: #00b578;
  background: #e8f8f0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  margin-top: 4rpx;
}
