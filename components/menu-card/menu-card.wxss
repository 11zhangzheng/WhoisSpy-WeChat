.menu-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.menu-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.menu-card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-card-icon-green {
  background: #e8f8f0;
  color: #00b578;
}

.menu-card-icon-blue {
  background: #e8f4fd;
  color: #2196f3;
}

.menu-card-icon-orange {
  background: #fff3e0;
  color: #ff9800;
}

.menu-card-icon-gray {
  background: #f5f5f5;
  color: #888888;
}

.menu-card-content {
  flex: 1;
}

.menu-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.menu-card-subtitle {
  font-size: 24rpx;
  color: #888888;
}

.menu-card-badge {
  background: #fa5151;
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
}

.menu-card-arrow {
  font-size: 36rpx;
  color: #cccccc;
  margin-left: 16rpx;
}
