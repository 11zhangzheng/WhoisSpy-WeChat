.form-item {
  padding: 20rpx 0;
}

.form-item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12rpx;
}

.form-item-input {
  width: 100%;
  min-height: 96rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
  transition: all 0.2s ease;
}

.form-item-input-focus {
  border-color: #00b578;
  background: #ffffff;
}

.form-item-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333333;
}

.form-item-stepper {
  display: flex;
  align-items: center;
}

.form-item-toggle {
  display: flex;
  justify-content: flex-end;
}

.form-item-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.form-item-picker:active {
  background: #f0f0f0;
}

.form-item-picker-placeholder {
  color: #bbbbbb;
}

.form-item-picker-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.form-item-hint {
  font-size: 24rpx;
  color: #888888;
  margin-top: 8rpx;
}

.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 40rpx;
  color: #333333;
  border: none;
  padding: 0;
  line-height: 1;
}

.stepper-btn:active {
  background: #e8e8e8;
}

.stepper-btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.stepper-value {
  width: 96rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}
