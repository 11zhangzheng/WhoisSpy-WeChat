page {
  background: #f4f6f8;
  color: #111827;
  font-size: 28rpx;
}

view, text, input, textarea, button, form, scroll-view, picker {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
}

.panel {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.06);
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 14rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-label {
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  min-height: 88rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}

.btn {
  border-radius: 12rpx;
  border: none;
  font-size: 28rpx;
  line-height: 1;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
}

.btn-secondary {
  background: #e5e7eb;
  color: #111827;
}

.btn-danger {
  background: #dc2626;
  color: #ffffff;
}

.btn-success {
  background: #16a34a;
  color: #ffffff;
}

.btn-ghost {
  background: #f3f4f6;
  color: #111827;
}

.btn-sm {
  padding: 18rpx 24rpx;
}

.btn-md {
  padding: 22rpx 28rpx;
}

.btn-block {
  width: 100%;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #1e3a8a;
  font-size: 24rpx;
}

.chip-active {
  background: #1d4ed8;
  color: #ffffff;
}

.meta {
  font-size: 24rpx;
  color: #6b7280;
}

.divider {
  height: 1rpx;
  background: #e5e7eb;
  margin: 20rpx 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 18rpx;
  background: #fff;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #e0f2fe;
  color: #075985;
}

.badge-warn {
  background: #fef3c7;
  color: #92400e;
}

.badge-danger {
  background: #fee2e2;
  color: #991b1b;
}

.small {
  font-size: 22rpx;
  color: #6b7280;
}
