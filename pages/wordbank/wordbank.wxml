<view class="page-safe">
  <!-- Add Button -->
  <view class="add-section">
    <primary-button text="＋ 新增词库" type="primary" block="{{true}}" bindtap="onAdd" />
  </view>

  <!-- Word Bank List -->
  <view class="bank-list">
    <view class="bank-card" wx:for="{{wordBanks}}" wx:key="id">
      <view class="bank-header">
        <view class="bank-name">{{item.name}}</view>
        <view class="bank-badge" wx:if="{{item.isDefault}}">默认</view>
      </view>
      <view class="bank-words">
        <view class="bank-word">
          <text class="bank-word-label">平民词</text>
          <text class="bank-word-value">{{item.civilianWord}}</text>
        </view>
        <view class="bank-word-divider">/</view>
        <view class="bank-word">
          <text class="bank-word-label">卧底词</text>
          <text class="bank-word-value">{{item.spyWord}}</text>
        </view>
      </view>
      <view class="bank-actions">
        <primary-button text="设为默认" type="ghost" bindtap="onSetDefault" data-id="{{item.id}}" wx:if="{{!item.isDefault}}" />
        <primary-button text="编辑" type="secondary" bindtap="onEdit" data-id="{{item.id}}" />
        <primary-button text="删除" type="danger" bindtap="onDelete" data-id="{{item.id}}" />
      </view>
    </view>
  </view>

  <!-- Edit Form -->
  <view class="edit-modal" wx:if="{{editing}}">
    <view class="edit-mask" bindtap="onCancel"></view>
    <view class="edit-content">
      <view class="edit-title">{{editing.id ? '编辑词库' : '新增词库'}}</view>

      <form-item
        label="词库名称"
        type="input"
        placeholder="例如：水果"
        value="{{editing.name}}"
        bindchange="onNameChange"
      />

      <form-item
        label="平民词"
        type="input"
        placeholder="例如：苹果"
        value="{{editing.civilianWord}}"
        bindchange="onCivilianChange"
      />

      <form-item
        label="卧底词"
        type="input"
        placeholder="例如：梨子"
        value="{{editing.spyWord}}"
        bindchange="onSpyChange"
      />

      <view class="toggle-row">
        <text class="toggle-label">设为默认词库</text>
        <switch checked="{{editing.isDefault}}" bindchange="onDefaultToggle" color="#00b578" />
      </view>

      <view class="edit-actions">
        <primary-button text="取消" type="ghost" bindtap="onCancel" />
        <primary-button text="保存" type="primary" bindtap="onSave" />
      </view>
    </view>
  </view>
</view>
