/* Add Section */
.add-section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

/* Bank List */
.bank-list {
  padding: 0 32rpx;
}

.bank-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.bank-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.bank-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.bank-badge {
  background: #00b578;
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.bank-words {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.bank-word {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.bank-word-label {
  font-size: 22rpx;
  color: #888888;
}

.bank-word-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.bank-word-divider {
  font-size: 28rpx;
  color: #cccccc;
  margin-top: 20rpx;
}

.bank-actions {
  display: flex;
  gap: 16rpx;
}

.bank-actions primary-button {
  flex: 1;
}

/* Edit Modal */
.edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.edit-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.edit-content {
  position: relative;
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 48rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
}

.edit-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 40rpx;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.toggle-label {
  font-size: 30rpx;
  color: #333333;
}

.edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}

.edit-actions primary-button {
  flex: 1;
}
