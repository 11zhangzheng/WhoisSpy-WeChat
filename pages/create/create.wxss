/* Section Groups */
.section-group {
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.section-group-title {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-group-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* Toggle Row */
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.toggle-row:last-child {
  border-bottom: none;
}

.toggle-label {
  font-size: 30rpx;
  color: #333333;
}

/* Divider */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0;
}
