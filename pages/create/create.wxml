<view class="page-safe">
  <!-- Basic Settings -->
  <view class="section-group">
    <view class="section-group-title">基础设置</view>
    <view class="section-group-card">
      <form-item
        label="房间名称"
        type="input"
        placeholder="欢乐局"
        value="{{form.roomName}}"
        bindchange="onRoomNameChange"
      />
      <view class="divider"></view>
      <form-item
        label="玩家人数"
        type="stepper"
        value="{{form.playerCount}}"
        min="{{3}}"
        max="{{12}}"
        hint="3-12人"
        bindchange="onPlayerCountChange"
      />
      <view class="divider"></view>
      <form-item
        label="卧底人数"
        type="stepper"
        value="{{form.spyCount}}"
        min="{{1}}"
        max="{{3}}"
        hint="通常1人"
        bindchange="onSpyCountChange"
      />
      <view class="divider"></view>
      <form-item
        label="游戏轮数"
        type="stepper"
        value="{{form.rounds}}"
        min="{{1}}"
        max="{{10}}"
        hint="3轮"
        bindchange="onRoundsChange"
      />
    </view>
  </view>

  <!-- Timer Settings -->
  <view class="section-group">
    <view class="section-group-title">计时设置</view>
    <view class="section-group-card">
      <form-item
        label="发词时间"
        type="stepper"
        value="{{form.dealTime}}"
        min="{{10}}"
        max="{{60}}"
        hint="秒"
        bindchange="onDealTimeChange"
      />
      <view class="divider"></view>
      <form-item
        label="讨论时间"
        type="stepper"
        value="{{form.discussTime}}"
        min="{{30}}"
        max="{{180}}"
        hint="秒"
        bindchange="onDiscussTimeChange"
      />
    </view>
  </view>

  <!-- Word Bank Selection -->
  <view class="section-group">
    <view class="section-group-title">词库选择</view>
    <view class="section-group-card">
      <form-item
        label="当前词库"
        type="picker"
        placeholder="默认词库"
        value="{{form.wordBankName}}"
        bindtap="onWordBankTap"
      />
    </view>
  </view>

  <!-- Advanced Settings -->
  <view class="section-group">
    <view class="section-group-title">高级设置</view>
    <view class="section-group-card">
      <view class="toggle-row">
        <text class="toggle-label">允许观战</text>
        <switch checked="{{form.allowSpectate}}" bindchange="onAllowSpectateChange" color="#00b578" />
      </view>
      <view class="toggle-row">
        <text class="toggle-label">显示玩家昵称</text>
        <switch checked="{{form.showNickname}}" bindchange="onShowNicknameChange" color="#00b578" />
      </view>
      <view class="toggle-row">
        <text class="toggle-label">允许弃票</text>
        <switch checked="{{form.allowSkip}}" bindchange="onAllowSkipChange" color="#00b578" />
      </view>
    </view>
  </view>

  <!-- Bottom Action Bar -->
  <bottom-action-bar
    text="创建房间"
    loading="{{submitting}}"
    bindtap="onCreateRoom"
  />
</view>
