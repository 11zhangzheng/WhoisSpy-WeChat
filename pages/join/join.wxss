/* Join Page Styles */
.join-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.join-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.join-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.join-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.join-hint {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 32rpx;
}

.join-input {
  width: 100%;
  min-height: 96rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 8rpx;
}

.join-input:focus {
  border-color: #00b578;
  background: #ffffff;
}

.join-action {
  padding: 0 32rpx;
  margin-top: 48rpx;
}
