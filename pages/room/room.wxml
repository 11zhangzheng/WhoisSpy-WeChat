<view class="page-safe">
  <!-- Loading State -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-icon">🔄</view>
    <view class="loading-text">正在连接房间...</view>
  </view>

  <!-- Error State -->
  <view class="error-state" wx:if="{{!loading && error}}">
    <view class="error-icon">❌</view>
    <view class="error-text">{{error}}</view>
    <primary-button text="重新连接" type="primary" block="{{true}}" bindtap="bootstrap" />
    <view style="height: 16rpx;"></view>
    <primary-button text="返回首页" type="ghost" block="{{true}}" bindtap="onBackHome" />
  </view>

  <!-- Room Content -->
  <block wx:if="{{!loading && !error && room}}">
    <!-- Room Header -->
    <view class="room-header">
      <view class="room-info">
        <view class="room-code-row">
          <text class="room-code">房间 {{room.roomCode}}</text>
          <text class="copy-room-btn" bindtap="onCopyRoomCode">复制</text>
        </view>
        <view class="room-phase">第 {{room.roundNo}} 轮 · {{phaseText}}</view>
      </view>
      <view class="room-badge">{{room.aliveCount}} 人存活</view>
    </view>

    <!-- My Name -->
    <view class="my-name-card">
      <text class="my-name-label">我的名称</text>
      <text class="my-name-value">{{room.myName || '未命名'}}</text>
    </view>

    <!-- Lobby Phase -->
    <view class="phase-section" wx:if="{{room.status === 'lobby'}}">
      <view class="section-title">等待加入</view>
      <view class="player-count">已加入：{{room.players.length}} / {{room.config.playerCount}}</view>
      <player-grid
        players="{{room.lobbyPlayers}}"
        showSeatNo="{{true}}"
        bindselect="onPlayerSelect"
      />
      <view class="action-section">
        <primary-button
          text="开始游戏"
          type="primary"
          block="{{true}}"
          disabled="{{!room.canStartGame}}"
          bindtap="onStartGame"
        />
        <view class="action-hint" wx:if="{{room.players.length < 3}}">
          至少 3 名玩家加入后可以开始
        </view>
        <view class="action-hint" wx:else>
          只有创建房间的玩家可以开始游戏
        </view>
      </view>
    </view>

    <!-- Speaking Phase -->
    <view class="phase-section" wx:if="{{room.status === 'speaking'}}">
      <!-- Word Card -->
      <word-card
        word="{{room.myWord}}"
        showRefresh="{{room.canRerollWords}}"
        bindrefresh="onRerollWords"
      />

      <!-- Current Speaker -->
      <view class="speaker-card">
        <view class="speaker-label">当前发言玩家</view>
        <view class="speaker-name">{{room.currentSpeakerName}}</view>
        <view class="speaker-seat" wx:if="{{room.currentSpeakerSeatNo}}">座位 {{room.currentSpeakerSeatNo}}</view>
      </view>

      <!-- Player Grid -->
      <player-grid
        players="{{room.lobbyPlayers}}"
        currentSpeakerId="{{room.currentSpeakerId}}"
        showSeatNo="{{true}}"
      />

      <!-- Action -->
      <view class="action-section">
        <primary-button
          text="{{room.nextSpeakerText}}"
          type="primary"
          block="{{true}}"
          disabled="{{!room.canAdvanceSpeaker}}"
          bindtap="onNextSpeaker"
        />
        <view class="action-hint" wx:if="{{room.canAdvanceSpeaker}}">
          发言结束后点击下一位
        </view>
        <view class="action-hint" wx:else>
          等待当前玩家发言结束
        </view>
      </view>
    </view>

    <!-- Voting Phase -->
    <view class="phase-section" wx:if="{{room.status === 'voting'}}">
      <!-- Vote Header -->
      <view class="vote-header">
        <view class="vote-title">匿名投票</view>
        <view class="vote-progress">投票进度：{{room.votedCount}} / {{room.voteTotal}}</view>
      </view>

      <!-- Voted State -->
      <view class="voted-state" wx:if="{{room.hasVoted}}">
        <view class="voted-icon">✓</view>
        <view class="voted-text">你已提交投票</view>
        <view class="voted-hint">等待其他玩家完成投票</view>
      </view>

      <!-- Vote List -->
      <view class="vote-list" wx:if="{{room.canVote}}">
        <vote-item
          wx:for="{{room.votePlayers}}"
          wx:key="id"
          player="{{item}}"
          selected="{{selectedVoteTargetId === item.id}}"
          bindselect="onVoteTargetTap"
        />
      </view>

      <!-- Vote Actions -->
      <view class="vote-actions" wx:if="{{room.canVote}}">
        <primary-button
          text="弃票"
          type="ghost"
          bindtap="onSkipVote"
          wx:if="{{room.config.allowSkip}}"
        />
        <primary-button
          text="提交投票"
          type="primary"
          bindtap="onSubmitVote"
        />
      </view>

      <!-- Spectator State -->
      <view class="spectator-state" wx:if="{{room.me && !room.me.alive}}">
        <view class="spectator-text">你已出局，可以继续观看投票进度</view>
      </view>
    </view>

    <!-- Finished Phase -->
    <view class="phase-section" wx:if="{{room.status === 'finished'}}">
      <result-banner
        winner="{{room.winner}}"
        civilianWord="{{room.selectedWordPair.civilianWord}}"
        spyWord="{{room.selectedWordPair.spyWord}}"
      />

      <!-- Player List -->
      <view class="section-title">玩家身份</view>
      <player-grid
        players="{{room.finishedPlayers}}"
        showSeatNo="{{true}}"
        showRoles="{{true}}"
      />

      <!-- Actions -->
      <view class="action-section">
        <primary-button text="重新开始" type="primary" block="{{true}}" bindtap="onRestart" />
        <view style="height: 16rpx;"></view>
        <primary-button text="返回首页" type="secondary" block="{{true}}" bindtap="onBackHome" />
      </view>
    </view>

    <!-- Previous Round Result -->
    <view class="previous-result" wx:if="{{room.eliminatedName && room.status !== 'lobby' && room.status !== 'voting'}}">
      <view class="previous-result-label">上一轮淘汰</view>
      <view class="previous-result-name">{{room.eliminatedName}}</view>
    </view>
  </block>
</view>
