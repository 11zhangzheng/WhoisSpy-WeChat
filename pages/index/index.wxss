/* Index Page */

.page-index {
  min-height: 100vh;
  padding: 28rpx;
}

/* ========== Title ========== */

.index-title-row {
  margin-bottom: 28rpx;
}

.index-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

/* ========== Banner ========== */

.banner {
  margin-bottom: 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.banner-img {
  width: 100%;
  height: 360rpx;
  display: block;
}

/* ========== Menu List ========== */

.menu-list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.menu-item:active {
  background: #f8f8f8;
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-blue {
  background: #2563eb;
}

.menu-icon-green {
  background: #10b981;
}

.menu-icon-purple {
  background: #8b5cf6;
}

.menu-icon-amber {
  background: #f59e0b;
}

.menu-icon-gray {
  background: #6b7280;
}

.menu-icon-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
}

.menu-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.menu-desc {
  font-size: 24rpx;
  color: #999999;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cccccc;
  margin-left: 16rpx;
}

.menu-list .menu-item + .menu-item {
  border-top: 1rpx solid #f0f0f0;
}

/* ========== Rules Card ========== */

.rules-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
  animation: fadeIn 0.2s ease-out;
}

.rules-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.config-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.config-icon-text {
  font-size: 22rpx;
  color: #666666;
  font-weight: 700;
}

.config-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.rules-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rule-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #eef2ff;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
}

/* ========== Settings Card ========== */

.settings-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
  animation: fadeIn 0.2s ease-out;
}

.settings-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.settings-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.settings-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.settings-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.settings-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.settings-hint {
  font-size: 22rpx;
  color: #999999;
}

/* ========== Session Card ========== */

.session-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #e8f8f0;
}

.session-card:active {
  background: #f8f8f8;
}

.session-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.session-label {
  font-size: 24rpx;
  color: #999999;
}

.session-code {
  font-size: 36rpx;
  font-weight: 700;
  color: #2563eb;
  letter-spacing: 4rpx;
}

/* ========== Animation ========== */

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
