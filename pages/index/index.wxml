<view class="page-index">
  <!-- Banner -->
  <view class="banner">
    <image class="banner-img" src="/images/banner.png" mode="aspectFill" />
  </view>

  

  <!-- Menu List -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onCreateRoom">
      <view class="menu-icon-wrap menu-icon-blue">
        <text class="menu-icon-text">+</text>
      </view>
      <view class="menu-content">
        <text class="menu-name">创建房间</text>
        <text class="menu-desc">自定义规则，邀请好友一起玩</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onJoinRoom">
      <view class="menu-icon-wrap menu-icon-green">
        <text class="menu-icon-text">→</text>
      </view>
      <view class="menu-content">
        <text class="menu-name">加入房间</text>
        <text class="menu-desc">输入房间号，和朋友一起游戏</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onWordBank">
      <view class="menu-icon-wrap menu-icon-purple">
        <text class="menu-icon-text">📚</text>
      </view>
      <view class="menu-content">
        <text class="menu-name">词库管理</text>
        <text class="menu-desc">管理词库分类和自定义词汇</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onRulesToggle">
      <view class="menu-icon-wrap menu-icon-amber">
        <text class="menu-icon-text">?</text>
      </view>
      <view class="menu-content">
        <text class="menu-name">规则说明</text>
        <text class="menu-desc">查看游戏规则和玩法说明</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onToggleConfig">
      <view class="menu-icon-wrap menu-icon-gray">
        <text class="menu-icon-text">⚙</text>
      </view>
      <view class="menu-content">
        <text class="menu-name">设置</text>
        <text class="menu-desc">修改服务器地址等配置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- Rules Panel -->
  <view class="rules-card" wx:if="{{showRules}}">
    <view class="rules-header">
      <view class="config-icon-wrap">
        <text class="config-icon-text">?</text>
      </view>
      <text class="config-title">游戏规则</text>
    </view>
    <view class="rules-list">
      <view class="rule-item">
        <text class="rule-num">1</text>
        <text class="rule-text">创建房间后，其他人用房间号加入</text>
      </view>
      <view class="rule-item">
        <text class="rule-num">2</text>
        <text class="rule-text">游戏开始后，当前发言者点击"下一位"切换</text>
      </view>
      <view class="rule-item">
        <text class="rule-num">3</text>
        <text class="rule-text">发言结束后自动进入匿名投票</text>
      </view>
      <view class="rule-item">
        <text class="rule-num">4</text>
        <text class="rule-text">投票完成后系统淘汰得票最高者并判断胜负</text>
      </view>
      <view class="rule-item">
        <text class="rule-num">5</text>
        <text class="rule-text">游戏结束时揭晓平民词和卧底词</text>
      </view>
    </view>
  </view>

  <!-- Settings Panel -->
  <view class="settings-card" wx:if="{{showConfig}}">
    <view class="settings-header">
      <view class="config-icon-wrap">
        <text class="config-icon-text">⚙</text>
      </view>
      <text class="config-title">服务器设置</text>
    </view>
    <view class="settings-body">
      <view class="settings-field">
        <text class="settings-label">服务器地址</text>
        <input
          class="settings-input"
          placeholder="ws://127.0.0.1:3001"
          value="{{serverUrl}}"
          bindinput="onServerUrlInput"
          confirm-type="done"
        />
      </view>
      <text class="settings-hint">修改后自动保存，创建/加入房间时生效</text>
    </view>
  </view>

  <!-- Active Session -->
  <view class="session-card" wx:if="{{session}}" bindtap="onContinueRoom">
    <view class="session-left">
      <text class="session-label">当前房间</text>
      <text class="session-code">{{session.roomCode}}</text>
    </view>
    <text class="menu-arrow">›</text>
  </view>
</view>
